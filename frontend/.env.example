# Frontend-only variables (for Vercel, set these in Project Settings ->
# Environment Variables). Never put server secrets in a VITE_ variable.

# Public Supabase project URL and anon key (Google sign-in).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Full URL of the backend API. On Vercel point this at the Render service,
# e.g. https://your-service.onrender.com/api. When the backend serves the
# frontend itself (single Render service) use /api.
VITE_API_BASE_URL=https://your-service.onrender.com/api

# GitHub connect: the API redirects to <this frontend origin>/github/callback,
# so set GITHUB_FRONTEND_ORIGIN on Render to this deployment's origin (e.g.
# https://your-app.vercel.app) and add it to CORS_ORIGINS.

# Razorpay public checkout key (optional; the server also returns it).
VITE_RAZORPAY_KEY_ID=

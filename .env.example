# Backend: NVIDIA Nemotron (never commit a real key)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
DETAILED_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Code editing (plan, patch, self-review) uses Ultra; Super VL is used only
# when the Ultra endpoint is unavailable or returns no content.
CODE_EDITING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
CODE_EDITING_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSION=2048
# Adaptive hosted batching: start at 32 passages and 160,000 characters,
# then fall back to 4 passages if a provider payload is rejected.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MIN_BATCH_SIZE=4
EMBEDDING_BATCH_MAX_CHARACTERS=160000
EMBEDDING_CACHE_MAX_REPOSITORY_BYTES=25000000
EMBEDDING_CHUNK_BUFFER_SIZE=256
# Match the per-key limit shown in NVIDIA API Catalog. This is not a quota increase.
NVIDIA_CALLS_PER_MINUTE=40
QUERY_EMBEDDING_RESERVE_PER_MINUTE=8
EMBEDDING_RETRY_ATTEMPTS=5
EMBEDDING_RETRY_BASE_SECONDS=2
EMBEDDING_PROGRESS_INTERVAL_BATCHES=4
EMBEDDING_HEARTBEAT_INTERVAL_BATCHES=2
CHUNK_INSERT_BATCH_SIZE=250
INGESTION_CHUNK_WORKERS=2
INGESTION_LARGE_FILE_SERIAL_BYTES=8000000
MEMORY_TARGET_MB=350
MEMORY_WARNING_MB=400
MEMORY_CRITICAL_MB=450
EMBEDDING_CONCURRENCY=1

# Backend: Supabase is used only to validate Google-authenticated sessions.
SUPABASE_URL=
SUPABASE_KEY=

# Backend: Turso owns repositories, ingestion jobs, chunks, vectors, and chat.
# These values are server secrets. Never prefix them with VITE_.
TURSO_DATABASE_URL=libsql://YOUR_DATABASE-YOUR_ORGANIZATION.turso.io
TURSO_AUTH_TOKEN=

# Razorpay billing (backend only). Never expose RAZORPAY_KEY_SECRET to Vite.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TEAM_PLAN_AMOUNT_PAISE=30000
TEAM_PLAN_DURATION_DAYS=30
FREE_CODEBASE_BYTES=200000000
TEAM_CODEBASE_BYTES=800000000

# Backend: GitHub OAuth for branch & pull request creation (optional until user connects GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback
# Required: origin serving the SPA. OAuth redirects to {origin}/github/callback
# (code in the URL fragment); the SPA then POSTs /api/github/complete.
GITHUB_FRONTEND_ORIGIN=http://localhost:5173
# Render supplies RENDER_EXTERNAL_URL automatically. Set the two values above
# explicitly in production to the exact registered GitHub OAuth URLs.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=
EDITING_TICKET_SECRET=
EDITING_TICKET_TTL_SECONDS=600
GITHUB_OAUTH_STATE_TTL_SECONDS=600
MAX_GITHUB_CHANGE_BYTES=10000000
GITHUB_EDITOR_MAX_BYTES=2000000

# Frontend configuration (the frontend reads these from the project root).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Razorpay's public checkout key only; keep the secret above server-side.
VITE_RAZORPAY_KEY_ID=
# Local development: http://localhost:8000/api
# Render production: /api
VITE_API_BASE_URL=http://localhost:8000/api

# Optional backend controls
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

INGESTION_JOB_TIMEOUT_SECONDS=900
MAX_INGESTION_ATTEMPTS=3
# Set to false only when another process is responsible for calling the queue worker.
LOCAL_INGESTION_WORKER=true
LOCAL_INGESTION_POLL_SECONDS=3
MAX_REPOSITORY_FILES=10000
MAX_REPOSITORY_BYTES=100000000
MAX_FILE_SIZE_BYTES=50000000
MAX_REPOSITORY_CHUNKS=15000
MAX_REPOSITORIES_PER_USER=30
MAX_ACTIVE_INGESTION_JOBS_PER_USER=1
INGEST_REQUESTS_PER_MINUTE=6
QUERY_REQUESTS_PER_MINUTE=12
MAX_CONCURRENT_QUERIES_PER_USER=2
CLONE_TIMEOUT_SECONDS=180
MAX_CONTEXT_CHARACTERS=40000
EDITING_CONTEXT_CHARACTERS=120000
RETRIEVAL_TOP_K=8
EDITING_RETRIEVAL_TOP_K=32
EDITING_MAX_FILES=8
EDITING_MAX_CHUNKS_PER_FILE=256
DENSE_CANDIDATE_LIMIT=256
ANSWER_RETRY_ATTEMPTS=2
OVERVIEW_RETRIEVAL_CANDIDATES=64

# Large repositories are indexed by importance within these budgets instead of
# failing (MAX_REPOSITORY_FILES / MAX_REPOSITORY_BYTES / MAX_REPOSITORY_CHUNKS).
# Non-English locale catalogues are skipped unless INDEX_TRANSLATIONS=true.
INDEX_TRANSLATIONS=false
# Apply the additive migrations in turso/ automatically at startup.
AUTO_MIGRATE=true
# Free Render instances sleep after 15 idle minutes; while an indexing job runs
# the worker pings its own health endpoint so the job is not frozen.
KEEPALIVE_DURING_INGESTION=true
# Code editing: generous output budget for multi-file patches.
CODE_EDITING_ANSWER_MAX_TOKENS=8192
NVIDIA_TIMEOUT_SECONDS=150
